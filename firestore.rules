rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Article validator
    function isValidArticle(data) {
      return data.title is string && data.title.size() <= 200
        && data.excerpt is string && data.excerpt.size() <= 500
        && data.category is string
        && data.categoryName is string
        && data.image is string;
    }

    // Forum post validator
    function isValidForumPost(data) {
      return data.author is string && data.author.size() > 0 && data.author.size() <= 100
        && data.topic is string && data.topic.size() <= 150
        && data.message is string && data.message.size() > 0 && data.message.size() <= 1000;
    }

    // Article comment validator
    function isValidComment(data) {
      return data.articleId is string && data.articleId.size() > 0
        && data.author is string && data.author.size() > 0 && data.author.size() <= 100
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000;
    }

    // Quiz result validator
    function isValidQuizResult(data) {
      return data.score is number && data.total is number && data.score <= data.total;
    }

    // Articles collection
    match /articles/{articleId} {
      allow read: if true;
      allow create, update: if isValidArticle(request.resource.data);
      allow delete: if isSignedIn();
    }

    // Forum posts collection
    match /forum_posts/{postId} {
      allow read: if true;
      allow create, update: if isValidForumPost(request.resource.data);
      allow delete: if isSignedIn();
    }

    // Article comments collection
    match /article_comments/{commentId} {
      allow read: if true;
      allow create, update: if isValidComment(request.resource.data);
      allow delete: if isSignedIn();
    }

    // Quiz results collection
    match /quiz_results/{resultId} {
      allow read: if true;
      allow create: if isValidQuizResult(request.resource.data);
      allow update, delete: if isSignedIn();
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
